{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "fingerprint-exit",
      "protocol": "freedom",
      "settings": {
        "tcpFingerprint": "auto",
        "tcpFingerprintFallback": "linux"
      }
    }
  ]
}
