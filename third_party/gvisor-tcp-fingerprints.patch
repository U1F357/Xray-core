+func TestFingerprintPassiveOpen(t *testing.T) {
+	for _, profile := range []tcpip.TCPFingerprintProfile{tcpip.TCPFingerprintWindows, tcpip.TCPFingerprintMacOS, tcpip.TCPFingerprintLinux} {
+		t.Run(fmt.Sprint(profile), func(t *testing.T) {
+			c := context.NewWithOpts(t, context.Options{EnableV4: true, MTU: 1500, UseDefaultTCPFingerprint: true})
+			defer c.Cleanup()
+			if err := c.Stack().SetTransportProtocolOption(tcp.ProtocolNumber, &profile); err != nil {
+				t.Fatal(err)
+			}
+			// The fixture checks the upstream receive scale and TS/SACK negotiation.
+			c.AcceptWithOptionsNoDelay(int(c.WindowScale), header.TCPSynOptions{MSS: 1460, WS: 3, TS: true, TSVal: 123, SACKPermitted: true})
+		})
+	}
+}
+
+func TestFingerprintUserMSSAndInvalidOption(t *testing.T) {
+	for _, profile := range []tcpip.TCPFingerprintProfile{tcpip.TCPFingerprintWindows, tcpip.TCPFingerprintMacOS, tcpip.TCPFingerprintLinux} {
+		t.Run(fmt.Sprint(profile), func(t *testing.T) {
+			c := context.NewWithOpts(t, context.Options{EnableV4: true, MTU: 1500, UseDefaultTCPFingerprint: true})
+			defer c.Cleanup()
+			if err := c.Stack().SetTransportProtocolOption(tcp.ProtocolNumber, &profile); err != nil {
+				t.Fatal(err)
+			}
+			invalid := tcpip.TCPFingerprintProfile(99)
+			if _, ok := c.Stack().SetTransportProtocolOption(tcp.ProtocolNumber, &invalid).(*tcpip.ErrInvalidOptionValue); !ok {
+				t.Fatal("invalid profile accepted")
+			}
+			var got tcpip.TCPFingerprintProfile
+			if err := c.Stack().TransportProtocolOption(tcp.ProtocolNumber, &got); err != nil || got != profile {
+				t.Fatalf("profile changed after invalid option: %d, %v", got, err)
+			}
+			c.Create(-1)
+			if err := c.EP.SetSockOptInt(tcpip.MaxSegOption, 1200); err != nil {
+				t.Fatal(err)
+			}
+			if _, ok := c.EP.Connect(tcpip.FullAddress{Addr: context.TestAddr, Port: context.TestPort}).(*tcpip.ErrConnectStarted); !ok {
+				t.Fatal("Connect did not start")
+			}
+			v := c.GetPacket()
+			defer v.Release()
+			syn := header.TCP(header.IPv4(v.AsSlice()).Payload())
+			if opts := header.ParseSynOptions(syn.Options(), false); opts.MSS != 1200 {
+				t.Fatalf("MSS=%d, want 1200", opts.MSS)
+			}
+		})
+	}
+}
