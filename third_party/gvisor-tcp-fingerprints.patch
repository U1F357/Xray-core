+// makeWindowsSynOptions emits MSS, NOP, WS, NOP, NOP, SACK-permitted.
+// MSS remains route-dependent. Each group is four-byte aligned, so no EOL
+// option is needed. Timestamps are deliberately not offered by this profile.
+func makeWindowsSynOptions(opts header.TCPSynOptions) []byte {
+	options := getOptions()
+	offset := header.EncodeMSSOption(uint32(opts.MSS), options)
+	if opts.WS >= 0 {
+		offset += header.EncodeNOP(options[offset:])
+		offset += header.EncodeWSOption(opts.WS, options[offset:])
+	}
+	if opts.SACKPermitted {
+		offset += header.EncodeNOP(options[offset:])
+		offset += header.EncodeNOP(options[offset:])
+		offset += header.EncodeSACKPermittedOption(options[offset:])
+	}
