+
+package tcp
+
+import (
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/seqnum"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"testing"
+
+	"gvisor.dev/gvisor/pkg/buffer"
+)
+
+func TestClassicECNNegotiation(t *testing.T) {
+	for _, offer := range []bool{false, true} {
+		for _, ae := range []bool{false, true} {
+			for bits := 0; bits < 4; bits++ {
+				c := classicECN{offered: offer}
+				c.negotiate(header.TCPFlagSyn|header.TCPFlagAck|header.TCPFlags(bits<<6), ae)
+				want := offer && !ae && bits == 1
+				if c.enabled != want || c.offered {
+					t.Fatalf("offer=%v ae=%v bits=%d: %+v", offer, ae, bits, c)
+				}
+			}
+		}
+	}
+}
+
+func TestClassicECNOutgoing(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		for _, fresh := range []bool{false, true} {
+			for _, flags := range []header.TCPFlags{header.TCPFlagAck, header.TCPFlagRst | header.TCPFlagAck, header.TCPFlagSyn} {
+				c := classicECN{enabled: enabled, echo: true, pendingCWR: true}
+				tf := tcpFields{flags: flags, tos: 0x28}
+				cwr := c.prepare(&tf, fresh)
+				active := enabled && flags == header.TCPFlagAck
+				wantFlags := flags
+				wantTOS := uint8(0x28)
+				if active {
+					wantFlags |= header.TCPFlagEce
+					if fresh {
+						wantFlags |= header.TCPFlagCwr
+						wantTOS |= 2
+					}
+				}
+				if tf.flags != wantFlags || tf.tos != wantTOS || cwr != (active && fresh) || !c.pendingCWR {
+					t.Fatalf("enabled=%v fresh=%v flags=%x: %+v", enabled, fresh, flags, tf)
+				}
+			}
+		}
+	}
+}
+
+func TestClassicECNReceiveFeedback(t *testing.T) {
+	for _, v6 := range []bool{false, true} {
+		ep := Endpoint{ecn: classicECN{enabled: true}}
+		pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{ReserveHeaderBytes: 60})
+		pkt.NetworkProtocolNumber = header.IPv4ProtocolNumber
+		ip := pkt.NetworkHeader().Push(20)
+		ip[0] = 0x45
+		ip[1] = 3
+		if v6 {
+			pkt.DecRef()
+			pkt = stack.NewPacketBuffer(stack.PacketBufferOptions{ReserveHeaderBytes: 60})
+			pkt.NetworkProtocolNumber = header.IPv6ProtocolNumber
+			ip = pkt.NetworkHeader().Push(40)
+			ip[0] = 0x60
+			ip[1] = 0x30
+		}
+		// payloadSize uses the packet data, not the network header.
+		seg := segment{pkt: pkt, flags: header.TCPFlagAck}
+		ep.receiveECN(&seg)
+		if ep.ecn.echo {
+			t.Fatal("CE on a pure ACK must not latch ECE")
+		}
+		ep.ecn.echo = true
+		seg.flags |= header.TCPFlagCwr
+		ep.receiveECN(&seg)
+		if ep.ecn.echo {
+			t.Fatal("CWR did not clear ECE")
+		}
+		pkt.Data().AppendView(buffer.NewViewWithData([]byte{1}))
+		ep.receiveECN(&seg)
+		if !ep.ecn.echo {
+			t.Fatal("CE must override CWR on marked data")
+		}
+		if v6 {
+			ip[1] = 0
+		} else {
+			ip[1] = 0
+		}
+		seg.flags = header.TCPFlagAck
+		ep.receiveECN(&seg)
+		if !ep.ecn.echo {
+			t.Fatal("ECE must persist until CWR")
+		}
+		seg.flags |= header.TCPFlagCwr
+		ep.receiveECN(&seg)
+		if ep.ecn.echo {
+			t.Fatal("unmarked CWR must clear ECE")
+		}
+		pkt.DecRef()
+	}
+}
+
+func TestClassicECNWindowReduction(t *testing.T) {
+	ep := Endpoint{ecn: classicECN{enabled: true}}
+	s := sender{ep: &ep}
+	s.SndUna = 100
+	s.SndNxt = 200
+	s.SndCwnd = 20
+	s.Outstanding = 20
+	s.Ssthresh = 1000
+	s.cc = newRenoCC(&s)
+	seg := segment{flags: header.TCPFlagAck | header.TCPFlagEce, ackNumber: 150}
+	s.handleECNEcho(&seg)
+	if s.SndCwnd != 10 || s.Ssthresh != 10 || !ep.ecn.pendingCWR {
+		t.Fatalf("no congestion response: cwnd=%d threshold=%d", s.SndCwnd, s.Ssthresh)
+	}
+	for _, ack := range []seqnum.Value{99, 150, 160, 200, 201} {
+		seg.ackNumber = ack
+		s.handleECNEcho(&seg)
+		if s.SndCwnd != 10 {
+			t.Fatalf("repeat or invalid ACK %d reduced twice", ack)
+		}
+	}
+	s.SndUna = 200
+	s.SndNxt = 300
+	s.Outstanding = 10
+	seg.ackNumber = 250
+	s.handleECNEcho(&seg)
+	if s.SndCwnd != 5 {
+		t.Fatalf("new flight did not reduce: %d", s.SndCwnd)
+	}
+}
+
+func TestAccECNSenderWrapAndOrdering(t *testing.T) {
+	ep := Endpoint{ecn: classicECN{enabled: true, accurate: true, txACE: 5, feedbackAck: 100, feedbackSeq: 10, feedbackSeen: true}}
+	s := sender{ep: &ep}
+	s.SndUna = 100
+	s.SndNxt = 2000
+	s.SndCwnd = 20
+	s.Outstanding = 20
+	s.MaxPayloadSize = 100
+	s.Ssthresh = 1000
+	s.cc = newRenoCC(&s)
+	pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{ReserveHeaderBytes: 20})
+	defer pkt.DecRef()
+	h := pkt.TransportHeader().Push(20)
+	h[12] = 0x51
+	seg := segment{pkt: pkt, flags: header.TCPFlagAck | header.TCPFlagEce, ackNumber: 900, sequenceNumber: 11}
+	// ACE stays at 5, but an ACK covering eight MSS can hide a full wrap.
+	s.handleECNEcho(&seg)
+	if s.SndCwnd != 10 {
+		t.Fatalf("ambiguous ACE wrap did not reduce cwnd: %d", s.SndCwnd)
+	}
+	seg.ackNumber = 800
+	seg.sequenceNumber = 10
+	seg.flags = header.TCPFlagAck | header.TCPFlagCwr // delayed ACE 6
+	s.handleECNEcho(&seg)
+	if ep.ecn.txACE != 5 || s.SndCwnd != 10 {
+		t.Fatal("superseded ACK changed ECN state")
+	}
+	seg.ackNumber = 1000
+	seg.sequenceNumber = 12
+	s.handleECNEcho(&seg)
+	if ep.ecn.txACE != 6 || s.SndCwnd != 10 {
+		t.Fatal("same flight reduced more than once")
+	}
+	s.SndUna = 2000
+	s.SndNxt = 3000
+	s.Outstanding = 10
+	seg.ackNumber = 2100
+	seg.sequenceNumber = 13
+	seg.flags |= header.TCPFlagEce // ACE 7
+	s.handleECNEcho(&seg)
+	if s.SndCwnd != 5 {
+		t.Fatalf("next flight did not reduce: %d", s.SndCwnd)
+	}
+}
