+// Save actual emitted IP packets for independent tcpdump/Wireshark inspection.
+func saveSYN(t *testing.T, packet []byte, name string) {
+	t.Helper()
+	dir := os.Getenv("TEST_UNDECLARED_OUTPUTS_DIR")
+	if dir == "" {
+		return
+	}
+	var b bytes.Buffer
+	for _, v := range []any{uint32(0xa1b2c3d4), uint16(2), uint16(4), uint32(0), uint32(0), uint32(65535), uint32(101), uint32(0), uint32(0), uint32(len(packet)), uint32(len(packet))} {
+		if err := binary.Write(&b, binary.LittleEndian, v); err != nil {
+			t.Fatal(err)
+		}
+	}
+	b.Write(packet)
+	if err := os.WriteFile(filepath.Join(dir, name+".pcap"), b.Bytes(), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
