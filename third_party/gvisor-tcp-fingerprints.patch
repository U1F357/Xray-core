+func TestFingerprintProfiles(t *testing.T) {
+	for _, profile := range []struct {
+		name   string
+		option tcpip.TCPFingerprintProfile
+		window uint16
+		scale  uint8
+		kinds  string
+	}{
+		{"windows", tcpip.TCPFingerprintWindows, 64240, 8, "2-1-3-1-1-4"},
+		{"macos", tcpip.TCPFingerprintMacOS, 65535, 6, "2-1-3-1-1-8-4-0"},
+		{"linux", tcpip.TCPFingerprintLinux, 65535, 9, "2-4-8-1-3"},
+	} {
+		for _, v6 := range []bool{false, true} {
+			for _, mtu := range []uint32{1500, 1280} {
+				for _, peerWS := range []int{-1, 0, 7} {
+					for _, peerTS := range []bool{false, true} {
+						name := fmt.Sprintf("%s_v6=%t_mtu=%d_peerWS=%d_peerTS=%t", profile.name, v6, mtu, peerWS, peerTS)
+						t.Run(name, func(t *testing.T) {
+							clock := faketime.NewManualClock()
+							c := context.NewWithOpts(t, context.Options{EnableV4: true, EnableV6: true, MTU: mtu, Clock: clock, UseDefaultTCPFingerprint: true})
+							defer c.Cleanup()
+							var enabled tcpip.TCPFingerprintProfile
+							if err := c.Stack().TransportProtocolOption(tcp.ProtocolNumber, &enabled); err != nil || enabled != tcpip.TCPFingerprintNative {
+								t.Fatalf("default profile = %v, %v", enabled, err)
+							}
+							{
+								if err := c.Stack().SetTransportProtocolOption(tcp.ProtocolNumber, &profile.option); err != nil {
+									t.Fatal(err)
+								}
+							}
+							addr := context.TestAddr
+							ipLen := header.IPv4MinimumSize
+							send := c.SendPacket
+							read := func() []byte { v := c.GetPacket(); defer v.Release(); return bytes.Clone(v.AsSlice()) }
+							if v6 {
+								c.CreateV6Endpoint(true)
+								addr = context.TestV6Addr
+								ipLen = header.IPv6MinimumSize
+								send = c.SendV6Packet
+								read = func() []byte { v := c.GetV6Packet(); defer v.Release(); return bytes.Clone(v.AsSlice()) }
+							} else {
+								c.Create(-1)
+							}
+							if _, ok := c.EP.Connect(tcpip.FullAddress{Addr: addr, Port: context.TestPort}).(*tcpip.ErrConnectStarted); !ok {
+								t.Fatal("Connect did not start")
+							}
+							packet := read()
+							syn := header.TCP(packet[ipLen:])
+							mss := uint16(mtu) - uint16(ipLen) - header.TCPMinimumSize
+							wantOpts := []byte{2, 4, byte(mss >> 8), byte(mss), 1, 3, 3, 8, 1, 1, 4, 2}
+							actualOpts := bytes.Clone(syn.Options())
+							switch profile.option {
+							case tcpip.TCPFingerprintMacOS:
+								wantOpts = []byte{2, 4, byte(mss >> 8), byte(mss), 1, 3, 3, 6, 1, 1, 8, 10, 0, 0, 0, 0, 0, 0, 0, 0, 4, 2, 0, 0}
+								if len(actualOpts) == 24 {
+									clear(actualOpts[12:20])
+								}
+							case tcpip.TCPFingerprintLinux:
+								wantOpts = []byte{2, 4, byte(mss >> 8), byte(mss), 4, 2, 8, 10, 0, 0, 0, 0, 0, 0, 0, 0, 1, 3, 3, 9}
+								if len(actualOpts) == 20 {
+									clear(actualOpts[8:16])
+								}
+							}
+							wantFlags := header.TCPFlagSyn
+							if profile.option != tcpip.TCPFingerprintLinux {
+								wantFlags |= header.TCPFlagEce | header.TCPFlagCwr
+							}
+							if syn.Flags() != wantFlags || syn.WindowSize() != profile.window || !bytes.Equal(actualOpts, wantOpts) {
+								t.Fatalf("SYN flags=%v window=%d options=%x, want SYN/%d/%x", syn.Flags(), syn.WindowSize(), syn.Options(), profile.window, wantOpts)
+							}
+							t.Logf("JA4T=%d_%s_%d_%d", profile.window, profile.kinds, mss, profile.scale)
+							saveSYN(t, packet, name)
+							// The setting is sampled once; changing it cannot corrupt a retry.
+							disabled := tcpip.TCPFingerprintNative
+							if err := c.Stack().SetTransportProtocolOption(tcp.ProtocolNumber, &disabled); err != nil {
+								t.Fatal(err)
+							}
+							clock.Advance(tcp.InitialRTO)
+							retry := header.TCP(read()[ipLen:])
+							if retry.Flags() != header.TCPFlagSyn || retry.SequenceNumber() != syn.SequenceNumber() || retry.WindowSize() != syn.WindowSize() || !bytes.Equal(retry.Options(), syn.Options()) {
+								t.Fatalf("retransmitted SYN changed: %x", []byte(retry))
+							}
+							opts := make([]byte, 40)
+							n := header.EncodeMSSOption(uint32(mss), opts)
+							n += header.EncodeSACKPermittedOption(opts[n:])
+							if peerWS >= 0 {
+								n += header.EncodeWSOption(peerWS, opts[n:])
+							}
+							if peerTS {
+								n += header.EncodeTSOption(123, header.ParseSynOptions(syn.Options(), false).TSVal, opts[n:])
+							}
+							n += header.AddTCPOptionPadding(opts, n)
+							const peerISN = 1000
+							h := context.Headers{SrcPort: context.TestPort, DstPort: syn.SourcePort(), SeqNum: peerISN, AckNum: seqnum.Value(syn.SequenceNumber() + 1), Flags: header.TCPFlagSyn | header.TCPFlagAck, RcvWnd: 30000, TCPOpts: opts[:n]}
+							send(nil, &h)
+							ack := header.TCP(read()[ipLen:])
+							wantWindow := profile.window
+							if peerWS >= 0 {
+								wantWindow = uint16((uint32(profile.window) + (1 << profile.scale) - 1) >> profile.scale)
+							}
+							if ack.Flags() != header.TCPFlagAck || ack.AckNumber() != peerISN+1 || header.ParseTCPOptions(ack.Options()).TS != (peerTS && profile.option != tcpip.TCPFingerprintWindows) || ack.WindowSize() != wantWindow {
+								t.Fatalf("handshake ACK flags=%v ack=%d window=%d options=%x; want window=%d", ack.Flags(), ack.AckNumber(), ack.WindowSize(), ack.Options(), wantWindow)
+							}
+							// Data in both directions must honor the negotiated TS state,
+							// including unsolicited timestamps sent to the Windows profile.
+							payload := []byte("fingerprint round trip")
+							if n, err := c.EP.Write(bytes.NewReader(payload), tcpip.WriteOptions{}); err != nil || n != int64(len(payload)) {
+								t.Fatalf("Write = %d, %v", n, err)
+							}
+							data := header.TCP(read()[ipLen:])
+							if !bytes.Equal(data.Payload(), payload) || header.ParseTCPOptions(data.Options()).TS != (peerTS && profile.option != tcpip.TCPFingerprintWindows) {
+								t.Fatalf("outbound data/options = %x/%x", data.Payload(), data.Options())
+							}
+							we, ch := waiter.NewChannelEntry(waiter.ReadableEvents)
+							c.WQ.EventRegister(&we)
+							defer c.WQ.EventUnregister(&we)
+							h.SeqNum = peerISN + 1
+							h.AckNum += seqnum.Value(len(payload))
+							h.Flags = header.TCPFlagAck | header.TCPFlagPsh
+							h.TCPOpts = nil
+							if peerTS && profile.option != tcpip.TCPFingerprintWindows {
+								ts := make([]byte, 12)
+								ts[0], ts[1] = 1, 1
+								header.EncodeTSOption(124, header.ParseTCPOptions(data.Options()).TSVal, ts[2:])
+								h.TCPOpts = ts
+							}
+							send(payload, &h)
+							select {
+							case <-ch:
+							case <-time.After(5 * time.Second):
+								t.Fatal("inbound data was not delivered")
+							}
+							var received bytes.Buffer
+							if _, err := c.EP.Read(&received, tcpip.ReadOptions{}); err != nil || !bytes.Equal(received.Bytes(), payload) {
+								t.Fatalf("Read = %q, %v", received.Bytes(), err)
+							}
+						})
+					}
+				}
+			}
+		}
+	}
+
+}
+
+func TestWindowsFingerprintSmallBufferAndSACKDisabled(t *testing.T) {
+	c := context.NewWithOpts(t, context.Options{EnableV4: true, MTU: 1500, UseDefaultTCPFingerprint: true})
+	defer c.Cleanup()
+	profile := tcpip.TCPFingerprintWindows
+	if err := c.Stack().SetTransportProtocolOption(tcp.ProtocolNumber, &profile); err != nil {
+		t.Fatal(err)
+	}
+	disabled := tcpip.TCPSACKEnabled(false)
+	if err := c.Stack().SetTransportProtocolOption(tcp.ProtocolNumber, &disabled); err != nil {
+		t.Fatal(err)
+	}
+	c.Create(4096)
+	if _, ok := c.EP.Connect(tcpip.FullAddress{Addr: context.TestAddr, Port: context.TestPort}).(*tcpip.ErrConnectStarted); !ok {
+		t.Fatal("Connect did not start")
+	}
+	v := c.GetPacket()
+	defer v.Release()
+	syn := header.TCP(header.IPv4(v.AsSlice()).Payload())
+	if syn.WindowSize() != 4096 || !bytes.Equal(syn.Options(), []byte{2, 4, 5, 180, 1, 3, 3, 8}) {
+		t.Fatalf("small buffer SYN window=%d options=%x", syn.WindowSize(), syn.Options())
+	}
+}
